# 复制本文件为 .env 并填入你的配置（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
#
# 本书所有代码走 OpenAI 兼容接口，换供应商只需改 BASE_URL 与 MODEL。
# 第 1~5 章的实验无需任何 API Key。

# ---------- LLM（第 6 章起需要） ----------

# OpenAI 官方
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MEM_MODEL=gpt-4o-mini

# DeepSeek
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AGENT_MEM_MODEL=deepseek-chat

# 通义千问（阿里云百炼）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MEM_MODEL=qwen-plus

# 本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# AGENT_MEM_MODEL=qwen2.5:7b

# ---------- Embedding（第 3 章起需要） ----------

# 默认中英双语小模型，约 400MB，CPU 可用
AGENT_MEM_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 完全离线时的退路：内置哈希向量，接口一致但质量很差
# AGENT_MEM_EMBED_MODEL=fake

# 国内下载加速
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 成本核算（第 10 章） ----------
# 用于把 token 数换算成金额，单位：美元 / 每百万 token。
# 请按你实际使用的模型价格填写，默认值仅为占位。
AGENT_MEM_PRICE_IN=0.15
AGENT_MEM_PRICE_OUT=0.60
